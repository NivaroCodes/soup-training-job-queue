# PostgreSQL connection string (replace placeholders; never commit real credentials)
DATABASE_URL=postgresql+psycopg://<username>:<password>@localhost:5432/soup_queue
# Optional dedicated database for pytest integration tests
TEST_DATABASE_URL=postgresql+psycopg://<username>:<password>@localhost:5432/soup_queue_test
SQLALCHEMY_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
